# Separate Supabase project for the product (not the website's). Public values only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Read only by src/lib/ai/config.ts. Empty = AI features show "IA não configurada".
ANTHROPIC_API_KEY=
# Server-only, optional (empty = defaults 10 and 25). They can only LOWER the ceilings stored in public.ai_limits.
AI_USER_DAILY_CAP_USD=
AI_GLOBAL_DAILY_CAP_USD=
# Server-only. Read only by src/lib/email/config.ts. Base64 of 32 random bytes; encrypts mailbox app passwords.
# Empty = the E-mail area cannot connect a mailbox ("Chave de cifra não configurada"); the rest works.
MAILBOX_ENC_KEY=
# Server-only, optional. The previous MAILBOX_ENC_KEY during a key rotation (only decrypts; reconnect mailboxes, then empty it).
MAILBOX_ENC_KEY_PREVIOUS=
# Server-only. Public https origin of this deployment, used in every unsubscribe link (e.g. https://your-app.vercel.app).
# Real sending is refused while it is empty, not https, or localhost. Rehearsal falls back to the request origin.
APP_PUBLIC_ORIGIN=
